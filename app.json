{
  "expo": {
    "name": "VAEL",
    "slug": "mens-discipline-app",
    "icon": "./assets/branding/vael-app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mensdiscipline",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/branding/vael-splash-mark-faint.png",
          "imageWidth": 174,
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-device-activity-monitor",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "icon": "./assets/branding/vael-app-icon.png",
      "bundleIdentifier": "com.temperline.mensdiscipline",
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.temperline.mensdiscipline"
        ]
      }
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "MensDisciplineDeviceActivityMonitor",
                  "bundleIdentifier": "com.temperline.mensdiscipline.deviceactivitymonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.temperline.mensdiscipline"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
