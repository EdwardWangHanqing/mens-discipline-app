{
  "expo": {
    "name": "Men's Discipline",
    "slug": "mens-discipline-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mensdiscipline",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "./plugins/with-device-activity-monitor"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.temperline.mensdiscipline",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access lets Men's Discipline verify broad movement and count repetitions on this device. Video is not saved or uploaded."
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.temperline.mensdiscipline"
        ]
      }
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "MensDisciplineDeviceActivityMonitor",
                  "bundleIdentifier": "com.temperline.mensdiscipline.deviceactivitymonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.temperline.mensdiscipline"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
